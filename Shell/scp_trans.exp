#!/usr/bin/expect -f

 set hostname [lindex $argv 0]
 set username "xcg6761"
 set password [lindex $argv 1]
 set enablepwd [lindex $argv 2]
 set image [lindex $argv 3] ]
 set timeout 300

spawn scp   /tftp/$image $username\@$hostname:/$image

expect "*assword:"
send "$password\n"
expect "*\r"
expect "\r"
expect eof
